<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- FULL SCREEN CONTENT -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:navGraph="@navigation/nav_graph"
        app:defaultNavHost="true"/>

    <!-- FLOATING HUD (OVERLAY ICONS - NO SIDEBAR) -->
    <FrameLayout
        android:id="@+id/side_nav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="18dp"
        android:layout_marginTop="120dp"

        android:clipChildren="false"
        android:clipToPadding="false"

        android:elevation="10dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start"
            android:rotation="-1.5">



            <!-- HOME -->
            <ImageView
                android:id="@+id/btnNavHome"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_home1"
                android:background="@drawable/nav_icon_glow"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.95"/>

            <!-- CHAT -->
            <ImageView
                android:id="@+id/btnNavChat"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_chat1"
                android:background="@drawable/nav_icon_glow"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.95"/>

            <!-- VOICE -->
            <ImageView
                android:id="@+id/btnNavVoice"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_voice1"
                android:background="@drawable/nav_icon_glow"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.95"/>

            <!-- CAMERA -->
            <ImageView
                android:id="@+id/btnNavCamera"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_camera1"
                android:background="@drawable/nav_icon_glow"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.95"/>

        </LinearLayout>

    </FrameLayout>

    <!-- SETTINGS (FLOATING TOP RIGHT) -->
    <ImageView
        android:id="@+id/btnNavSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/ic_settings1"
        android:background="@drawable/nav_icon_glow"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0.95"
        android:elevation="10dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>