<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <!-- SPIRIT (CENTER FOCUS - NO SIDEBAR FEEL) -->
    <ImageView
        android:id="@+id/imgSpirit"
        android:layout_width="450dp"
        android:layout_height="450dp"
        android:layout_centerInParent="true"
        android:src="@drawable/open_sp"
        android:alpha="0.98"
        android:scaleType="centerInside"/>

    <!-- OPTIONAL SOFT GLOW LAYER (biar hidup) -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true"
        android:background="@drawable/spirit_glow"
        android:alpha="0.15"/>

    <!-- STATUS BAR -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        android:layout_alignParentTop="true"
        android:layout_marginTop="40dp"
        android:layout_marginStart="20dp"

        android:padding="10dp"
        android:background="#33000000">

        <TextView
            android:id="@+id/txtFriendship"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤ Friendship : 0"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/pixel_sans_serif"/>

        <TextView
            android:id="@+id/txtMood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mood : Shy"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/pixel_sans_serif"/>

    </LinearLayout>

    <!-- DIALOG BOX (VN STYLE) -->
    <TextView
        android:id="@+id/txtDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="90dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:padding="14dp"
        android:background="#66000000"
        android:fontFamily="@font/pixel_sans_serif"/>

</RelativeLayout>