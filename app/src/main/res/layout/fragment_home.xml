<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <!-- SPIRIT (UKURAN 450DP - POPUP FROM BOTTOM) -->
    <ImageView
        android:id="@+id/imgSpirit"
        android:layout_width="450dp"
        android:layout_height="450dp"
        android:layout_centerInParent="true"
        android:src="@drawable/open_sp"
        android:alpha="0.0"
        android:visibility="invisible"
        android:scaleType="centerInside"/>

    <!-- STATUS BAR (STYLE YANG TADI) -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"
        android:padding="12dp"
        android:background="@drawable/bg_dialog">

        <TextView
            android:id="@+id/txtFriendship"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤️ Friendship : 0"
            android:textColor="#4E342E"
            android:textSize="14sp"
            android:fontFamily="@font/pixel_sans_serif"/>

        <TextView
            android:id="@+id/txtMood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😊 Mood : Shy"
            android:textColor="#4E342E"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/pixel_sans_serif"/>

    </LinearLayout>

    <!-- DIALOG BOX (VN STYLE) -->
    <TextView
        android:id="@+id/txtDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="90dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:padding="16dp"
        android:background="#66000000"
        android:fontFamily="@font/pixel_sans_serif"/>

</RelativeLayout>
